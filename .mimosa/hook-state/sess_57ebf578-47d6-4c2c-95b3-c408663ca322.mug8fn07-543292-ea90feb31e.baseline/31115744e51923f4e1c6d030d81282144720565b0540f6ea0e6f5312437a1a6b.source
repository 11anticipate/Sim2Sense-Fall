"""Compose unretouched Isaac screenshots; labels identify evidence sources."""

from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

ROOT = Path(__file__).resolve().parent
FONT = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 19)
PANELS = (
    ("sidewalk_full_reference/captures/frame_00436.png", "AMASS reference | t=3.633 s"),
    ("sidewalk_full/captures/frame_00436.png", "PhysX + bounded root force | t=3.633 s"),
    ("sidewalk_assisted/captures/frame_00360.png", "No barrier: actual PhysX | t=3.000 s"),
    ("sidewalk_barrier/captures/frame_00360.png", "Barrier: actual PhysX | t=3.000 s"),
)

canvas = Image.new("RGB", (1280, 1032), "white")
draw = ImageDraw.Draw(canvas)
for index, (relative, label) in enumerate(PANELS):
    x, y = index % 2 * 640, index // 2 * 516
    with Image.open(ROOT / relative) as source:
        canvas.paste(source.convert("RGB").resize((640, 480)), (x, y + 36))
    draw.text((x + 10, y + 8), label, font=FONT, fill="black")
canvas.save(ROOT / "evidence_comparison.png")

sequence = Image.new("RGB", (1920, 1296), "white")
draw = ImageDraw.Draw(sequence)
for row, directory in enumerate((
    "sidewalk_full_reference", "sidewalk_full", "backwalk_reference", "backwalk_clear"
)):
    paths = sorted((ROOT / directory / "captures").glob("frame_*.png"))
    assert len(paths) == 5
    for column, path in enumerate(paths):
        x, y = column * 384, row * 324
        frame = int(path.stem.split("_")[1])
        with Image.open(path) as source:
            sequence.paste(source.convert("RGB").resize((384, 288)), (x, y + 36))
        label = f"{directory} {frame / 120:.2f}s"
        draw.text((x + 5, y + 8), label, font=FONT, fill="black")
sequence.save(ROOT / "full_motion_sequences.png")
