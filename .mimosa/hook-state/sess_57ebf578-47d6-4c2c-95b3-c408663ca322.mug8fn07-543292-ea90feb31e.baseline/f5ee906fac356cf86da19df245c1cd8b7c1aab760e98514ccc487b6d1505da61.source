"""Unretouched live-viewport evidence from the keyboard trials."""

from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

root = Path(__file__).resolve().parent
panels = [
    ("gui_tilt/live_004.00.png", "Forward | live GUI, 4.00 s"),
    ("gui_tilt/live_005.00.png", "Brake | live GUI, 5.00 s"),
    ("gui_tilt/live_007.70.png", "Backward after turn | live GUI, 7.70 s"),
    ("barrier/live_004.00.png", "Forward blocked by wall | 4.00 s"),
]
canvas = Image.new("RGB", (1280, 1032), "white")
draw = ImageDraw.Draw(canvas)
font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 19)
for i, (path, label) in enumerate(panels):
    x, y = i % 2 * 640, i // 2 * 516
    with Image.open(root / path) as image:
        canvas.paste(image.convert("RGB").resize((640, 480)), (x, y + 36))
    draw.text((x + 8, y + 8), label, font=font, fill="black")
canvas.save(root / "keyboard_live_evidence.png")
