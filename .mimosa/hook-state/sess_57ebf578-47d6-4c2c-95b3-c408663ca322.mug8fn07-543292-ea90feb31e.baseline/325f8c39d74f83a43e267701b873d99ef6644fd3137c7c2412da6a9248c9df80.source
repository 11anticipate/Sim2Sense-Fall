#!/usr/bin/env python3
"""Per-motion arm-swing check for the P0-A item-4 motions (forward, stop, turn, back).

``task_plan.md`` P0-A item 4 asks for forward, backward, start/stop and turning to be
re-run and confirmed free of "right-arm sticking, jumping or abnormal twisting".
The screenshots need a human eye, but the *sticking* and *jumping* questions are
answerable from the recorded joint stream, and that is what this script does:

* **Sticking**: per primary-arm-DOF peak-to-peak span inside each commanded segment.
  A limb that is stuck shows ~0 deg while the opposite limb moves.
* **Jumping**: per-step change of every DOF in units of the controller's own
  ``max_joint_speed_rad_s`` limit. A jump is a step that violates the ramp the
  controller is allowed to command, so a single driving step is the reference.
* **Abnormal twisting**: the same per-step check restricted to the non-primary
  (twist) axes of the arm chains, since a twist blow-up is exactly the failure the
  multi-axis decomposition can introduce.

Segments come from the report's own ``command_timeline``, so the labels cannot
drift from what was actually commanded.

Usage::

    python3 artifacts/humans/arm_capture_motions/make_motion_montage.py \
        --run artifacts/humans/arm_capture_motions
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
from typing import Any

import numpy as np
from PIL import Image, ImageDraw, ImageFont

ARM_JOINTS = ("left_shoulder", "right_shoulder", "left_elbow", "right_elbow")
FONT_DIR = Path("/usr/share/fonts/truetype/dejavu")

# A right/left span ratio is meaningless when the left limb barely moved; dividing
# by a near-static denominator turns sensor noise into a ratio of 100+.
MIN_RATIO_DENOMINATOR_DEG = 1.0
# Steps sitting exactly on the controller ramp read as 1.00x after float rounding.
RAMP_EXCEEDANCE_TOLERANCE = 1.05
# A root displacement this large in one timestep is an ``R`` reset, not walking.
RESET_STEP_M = 0.05
# Minimum right/left primary-axis swing ratio for the right arm to count as
# swinging rather than stuck. This is the pre-registered ``min_shoulder_ratio``
# from ``configs/humans/arm_symmetry_gate.yaml``, reused rather than invented here.
MIN_SYMMETRY_RATIO = 0.75

# Human-readable names for the commanded motion each segment represents.
SEGMENT_LABELS = {
    (1.0, 0.0): "W forward",
    (0.0, 0.0): "stop / coast",
    (0.0, 1.0): "A turn left",
    (-1.0, 0.0): "S backward",
}


def _font(name: str, size: int) -> Any:
    path = FONT_DIR / name
    if not path.exists():
        raise FileNotFoundError(f"montage needs the DejaVu font at {path}")
    return ImageFont.truetype(str(path), size)


def segments(timeline: list[dict[str, Any]], total_s: float) -> list[dict[str, Any]]:
    """Turn the report's command change-points into labelled half-open segments."""

    out = []
    for index, row in enumerate(timeline):
        start = float(row["time_s"])
        stop = float(timeline[index + 1]["time_s"]) if index + 1 < len(timeline) else total_s
        command = tuple(float(v) for v in row["command"])
        label = SEGMENT_LABELS.get(command, f"command {command}")
        if stop - start > 0.05:
            out.append({"label": label, "command": command, "start_s": start, "stop_s": stop})
    return out


def _reset_steps(root: np.ndarray, limit_m: float = RESET_STEP_M) -> np.ndarray:
    """Boolean mask of steps that are ``R``-key resets rather than motion.

    The demo timeline ends with an ``R`` press; that re-spawns the character at the
    origin, which teleports the root (observed 0.92 m) and snaps every joint to the
    idle pose within a single step. Counting that as a control "jump" would flag a
    deliberate reset as a defect, so those steps are excluded from the ramp test --
    the same reasoning as ``travel.root_displacement_in_body_frame``.
    """

    planar = np.linalg.norm(np.diff(root[:, :2], axis=0), axis=1)
    return planar >= limit_m


def arm_analysis(
    *,
    time_s: np.ndarray,
    joints: np.ndarray,
    targets: np.ndarray,
    names: list[str],
    dt_s: float,
    max_joint_speed_rad_s: float,
    segments: list[dict[str, Any]],
    root: np.ndarray,
    cycle_period_s: float,
) -> dict[str, Any]:
    """Per-segment spans, ramp violations and twist excursions for the arm chains.

    A swing span is a peak-to-peak over a window, so it only equals the true
    amplitude when the window covers at least one whole phase cycle. The shipped
    gait cycle is 3.2 s (stride 1.286 m at 0.4 m/s) while the demo's W segment is
    3.0 s, i.e. 0.93 of a cycle -- measuring there under-reports the swing (17.4 deg
    against the 21.6 deg a full cycle gives). Segments shorter than one cycle are
    therefore reported with ``span_is_cyclic=false`` and are excluded from the
    sticking verdict, rather than being compared against a threshold they cannot
    physically meet.
    """

    primary = {
        name: name.split("__")[0] in ARM_JOINTS and name.endswith("__dof2") for name in names
    }
    chain_of = {name: name.split("__")[0] for name in names}
    arm_dofs = [name for name in names if chain_of[name] in ARM_JOINTS]

    # A controller step is bounded by max_joint_speed_rad_s * dt; anything beyond
    # that is not something the controller asked for. A small tolerance absorbs
    # float rounding -- steps sitting exactly on the limit otherwise read as 1.00x
    # violations.
    per_step_limit_deg = np.rad2deg(max_joint_speed_rad_s * dt_s)
    step_deg = np.rad2deg(np.abs(np.diff(joints, axis=0)))
    resets = _reset_steps(root)

    report: dict[str, Any] = {
        "per_step_controller_limit_deg": per_step_limit_deg,
        "ramp_exceedance_tolerance": RAMP_EXCEEDANCE_TOLERANCE,
        "reset_steps_excluded": int(resets.sum()),
        "segments": [],
    }
    for segment in segments:
        mask = (time_s[:-1] >= segment["start_s"]) & (time_s[:-1] < segment["stop_s"]) & ~resets
        if not mask.any():
            continue
        row: dict[str, Any] = {
            "label": segment["label"],
            "start_s": segment["start_s"],
            "stop_s": segment["stop_s"],
            "duration_s": segment["stop_s"] - segment["start_s"],
            "phase_cycles_covered": (segment["stop_s"] - segment["start_s"]) / cycle_period_s,
            "span_is_cyclic": (segment["stop_s"] - segment["start_s"]) >= cycle_period_s,
            "spans": {},
            "jump_ratio_max": float(step_deg[mask].max() / per_step_limit_deg),
            "jump_worst_dof": names[int(np.argmax(step_deg[mask].max(axis=0)))],
            "twist_jump_ratio_max": None,
            "twist_worst_dof": None,
        }
        for name in arm_dofs:
            index = names.index(name)
            in_window = joints[(time_s >= segment["start_s"]) & (time_s < segment["stop_s"]), index]
            row["spans"][name] = {
                "primary_axis": bool(primary[name]),
                "ptp_actual_deg": float(np.rad2deg(np.ptp(in_window))) if in_window.size else 0.0,
            }
        twist = [name for name in arm_dofs if not primary[name]]
        if twist:
            twist_ratio = step_deg[:, [names.index(n) for n in twist]]
            row["twist_jump_ratio_max"] = float(twist_ratio[mask].max() / per_step_limit_deg)
            row["twist_worst_dof"] = twist[int(np.argmax(twist_ratio[mask].max(axis=0)))]
        # Ratio of right to left on the primary swing axis, per joint pair. A ratio
        # is only meaningful when the left limb actually moved; dividing by a
        # near-static denominator would manufacture a huge number out of noise.
        for joint in ("shoulder", "elbow"):
            left = f"left_{joint}__dof2"
            right = f"right_{joint}__dof2"
            if left not in row["spans"] or right not in row["spans"]:
                continue
            denominator = row["spans"][left]["ptp_actual_deg"]
            key = f"right_over_left_{joint}_primary"
            if denominator < MIN_RATIO_DENOMINATOR_DEG:
                row[key] = None
                row[f"{key}_undefined_because"] = (
                    f"left {joint} span {denominator:.3f} deg is below the "
                    f"{MIN_RATIO_DENOMINATOR_DEG} deg floor"
                )
            else:
                row[key] = row["spans"][right]["ptp_actual_deg"] / denominator
        # The P0-A item-4 wording is "no right-arm sticking, jumping or abnormal
        # twisting". Turn that into explicit checks so the verdict is not a matter
        # of reading the numbers generously.
        row["checks"] = {
            # Sticking: during a commanded moving segment the right shoulder must
            # swing a comparable fraction of the left, and must move at all.
            "right_arm_moves": row["spans"].get("right_shoulder__dof2", {}).get(
                "ptp_actual_deg", 0.0
            )
            > MIN_RATIO_DENOMINATOR_DEG,
            "right_arm_not_stuck": (
                row.get("right_over_left_shoulder_primary") is None
                or row["right_over_left_shoulder_primary"] >= MIN_SYMMETRY_RATIO
            ),
            "no_jump": row["jump_ratio_max"] <= RAMP_EXCEEDANCE_TOLERANCE,
            "no_twist_blowup": row["twist_jump_ratio_max"] is None
            or row["twist_jump_ratio_max"] <= RAMP_EXCEEDANCE_TOLERANCE,
        }
        row["passes"] = all(row["checks"].values())
        report["segments"].append(row)

    del targets  # recorded for provenance; the spans use the executed joints
    return report


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run", type=Path, required=True)
    parser.add_argument("--thumb-w", type=int, default=300)
    parser.add_argument("--thumb-h", type=int, default=225)
    args = parser.parse_args(argv)

    run = args.run
    report = json.loads((run / "report.json").read_text(encoding="utf-8"))
    control = np.load(run / "control.npz")
    time_s = control["time_s"].astype(float)
    joints = control["joints"].astype(float)
    targets = control["joint_target"].astype(float)
    # ``control.npz`` columns follow the rig's DOF order, which is the insertion
    # order of the report's per-DOF error map. Recover it from the report rather
    # than assuming a sorted order, and refuse if the shapes disagree.
    names = list(report["joint_error_by_dof_deg"])
    if len(names) != joints.shape[1]:
        raise SystemExit(
            f"report lists {len(names)} DOFs but control.npz has {joints.shape[1]} columns"
        )
    dt_s = float(report["physics_dt_s"])
    max_speed = float(report["controller_settings"]["max_joint_speed_rad_s"])

    segs = segments(report["command_timeline"], float(time_s[-1]))
    analysis = arm_analysis(
        time_s=time_s,
        joints=joints,
        targets=targets,
        names=names,
        dt_s=dt_s,
        max_joint_speed_rad_s=max_speed,
        segments=segs,
        root=control["root"].astype(float),
    )

    # One montage row per segment; within a row the captured instants of that
    # segment, in order. Captures are matched by their requested simulation time.
    captures = sorted(report["captures"], key=lambda row: row["request_time_s"])
    per_segment: list[list[dict[str, Any]]] = []
    for segment in segs:
        inside = [
            row
            for row in captures
            if segment["start_s"] <= row["request_time_s"] < segment["stop_s"]
        ]
        per_segment.append(inside)

    tw, th = args.thumb_w, args.thumb_h
    header_h, row_label_h, gap = 34, 24, 6
    columns = max((len(rows) for rows in per_segment), default=1)
    canvas = Image.new(
        "RGB",
        (tw * columns + gap * (columns - 1), header_h + (row_label_h + th) * len(segs)),
        "white",
    )
    draw = ImageDraw.Draw(canvas)
    font = _font("DejaVuSans.ttf", 13)
    font_bold = _font("DejaVuSans-Bold.ttf", 15)
    draw.text(
        (6, 9),
        f"P0-A item 4 motions, az 270 (subject's right) - {run.name}",
        font=font_bold,
        fill="black",
    )

    missing: list[str] = []
    for row_index, (segment, rows) in enumerate(zip(segs, per_segment, strict=True)):
        y0 = header_h + row_index * (row_label_h + th)
        draw.text(
            (6, y0 + 4),
            f"{segment['label']}   t={segment['start_s']:.1f}-{segment['stop_s']:.1f} s",
            font=font,
            fill="black",
        )
        for column_index, record in enumerate(rows):
            x = column_index * (tw + gap)
            y = y0 + row_label_h
            path = Path(record["path"])
            if not path.is_file():
                missing.append(str(path))
                continue
            with Image.open(path) as image:
                canvas.paste(image.convert("RGB").resize((tw, th)), (x, y))
            draw.rectangle([x, y, x + tw - 1, y + th - 1], outline="#888888")
    target = run / "motion_montage.png"
    canvas.save(target)

    payload = {
        "run": str(run),
        "azimuth_deg": report["view_azimuths_deg"],
        "analysis": analysis,
        "captures_per_segment": {
            segment["label"]: len(rows) for segment, rows in zip(segs, per_segment, strict=True)
        },
        "montage": str(target),
    }
    (run / "motion_analysis.json").write_text(
        json.dumps(payload, indent=2, sort_keys=True), encoding="utf-8"
    )

    print(f"wrote {target} ({canvas.size[0]}x{canvas.size[1]})")
    print(f"controller ramp limit: {analysis['per_step_controller_limit_deg']:.3f} deg/step")
    print(f"reset steps excluded : {analysis['reset_steps_excluded']}")
    for row in analysis["segments"]:
        shoulder = row.get("right_over_left_shoulder_primary")
        elbow = row.get("right_over_left_elbow_primary")
        verdict = "PASS" if row["passes"] else "FAIL"
        failed = [name for name, ok in row["checks"].items() if not ok]
        print(
            f"  [{verdict}] {row['label']:14s} {row['duration_s']:4.1f}s"
            f"  jump<= {row['jump_ratio_max']:.2f}x ramp ({row['jump_worst_dof']})"
            f"  twist<= {row['twist_jump_ratio_max']:.2f}x"
        )
        print(
            f"           shouldR/L {_fmt(shoulder)}  elbowR/L {_fmt(elbow)}"
            + (f"  failed: {', '.join(failed)}" if failed else "")
        )
    if missing:
        print("missing screenshots:", ", ".join(missing))
    return 0


def _fmt(value: float | None) -> str:
    return "n/a" if value is None else f"{value:.3f}"


if __name__ == "__main__":
    raise SystemExit(main())
